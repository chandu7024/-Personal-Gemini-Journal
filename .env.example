# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Optional client-side Google Maps Platform API key.
# Restrict this key to HTTP referrers (*.run.app, localhost:3000) and Maps JS / Places API in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# EXTERNAL NOTIFICATION CONFIGURATION (Optional):
# Used by the server-side Notification Engine to dispatch live reflection emails and webhooks.
# For Gmail SMTP:
# NOTIFICATION_EMAIL_HOST="smtp.gmail.com"
# NOTIFICATION_EMAIL_PORT=465 (SSL) or 587 (TLS)
# NOTIFICATION_EMAIL_USER="your-gmail@gmail.com"
# NOTIFICATION_EMAIL_PASS="your-16-digit-google-app-password" (Generated at myaccount.google.com/apppasswords)
NOTIFICATION_EMAIL_HOST=
NOTIFICATION_EMAIL_PORT=587
NOTIFICATION_EMAIL_USER=
NOTIFICATION_EMAIL_PASS=
NOTIFICATION_EMAIL_FROM="ReflectAI <noreply@reflectai.app>"
NOTIFICATION_SLACK_WEBHOOK_URL=
NOTIFICATION_DISCORD_WEBHOOK_URL=

